---
import { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, readingTime, heroImage, heroImageAlt } = post.data;

const slug = post.slug;
const [country, ...slugParts] = slug.split('/');
const postSlug = slugParts.join('/');
const href = `/${country}/${postSlug}/`;
---

<article class="border border-primary/10 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
  {heroImage && (
    <img
      src={heroImage}
      alt={heroImageAlt || title}
      class="w-full h-48 object-cover"
    />
  )}
  <div class="p-6">
    <h3 class="font-display text-xl font-bold text-primary mb-2 hover:text-accent transition-colors">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-primary/80 text-sm mb-4">{description}</p>
    <div class="flex items-center justify-between text-xs text-primary/60">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {readingTime && <span>{readingTime} min read</span>}
    </div>
    <a href={href} class="inline-block mt-4 text-accent font-semibold hover:underline">
      Read article →
    </a>
  </div>
</article>
