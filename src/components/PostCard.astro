---
import { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, readingTime, heroImage, heroImageAlt, cluster } = post.data;

const slug = post.slug;
const country = cluster.split('/')[0];
const postSlug = slug.includes('/') ? slug.split('/').pop() : slug;
const href = `/${country}/${postSlug}/`;

// Cluster → emoji + soft pastel mapping for image fallback (Tilda-style: muted, friendly)
const clusterStyles: Record<string, { emoji: string; bg: string }> = {
  bali: { emoji: '🌴', bg: 'bg-gradient-to-br from-teal-50 via-emerald-50 to-cyan-100' },
  spain: { emoji: '🇪🇸', bg: 'bg-gradient-to-br from-amber-50 via-orange-50 to-red-100' },
  france: { emoji: '🇫🇷', bg: 'bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-100' },
  portugal: { emoji: '🇵🇹', bg: 'bg-gradient-to-br from-rose-50 via-pink-50 to-fuchsia-100' },
  hungary: { emoji: '🇭🇺', bg: 'bg-gradient-to-br from-lime-50 via-green-50 to-emerald-100' },
};
const style = clusterStyles[country] || { emoji: '✈️', bg: 'bg-soft' };

const useRealImage = heroImage && heroImage.startsWith('http');
---

<!-- Tilda-style card: no card frame, just rounded image + clean text below -->
<article class="group flex flex-col h-full">
  <a href={href} class="block mb-5">
    {useRealImage ? (
      <img
        src={heroImage}
        alt={heroImageAlt || title}
        class="w-full aspect-[4/3] object-cover rounded-tilda group-hover:opacity-90 transition-opacity duration-300"
        loading="lazy"
      />
    ) : (
      <div
        class={`w-full aspect-[4/3] ${style.bg} flex items-center justify-center rounded-tilda group-hover:opacity-90 transition-opacity duration-300`}
        aria-label={title}
      >
        <span class="text-6xl" aria-hidden="true">{style.emoji}</span>
      </div>
    )}
  </a>
  <div class="flex flex-col flex-1">
    <h3 class="font-display text-xl font-bold text-primary leading-tight mb-3 transition-colors group-hover:text-accent">
      <a href={href}>{title}</a>
    </h3>
    <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-primary/50 font-semibold">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      {readingTime && (
        <>
          <span class="opacity-50">·</span>
          <span>{readingTime} min</span>
        </>
      )}
    </div>
  </div>
</article>
