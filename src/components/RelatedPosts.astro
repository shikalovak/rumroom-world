---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  max?: number;
}

const { post, max = 3 } = Astro.props;

const allPosts = await getCollection('posts');
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.data.cluster === post.data.cluster &&
      p.slug !== post.slug &&
      !p.data.draft
  )
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, max);
---

{relatedPosts.length > 0 && (
  <section class="my-8 sm:my-10 md:my-12">
    <h2 class="font-display text-xl sm:text-2xl font-bold text-primary mb-6 sm:mb-8">More from {post.data.cluster.split('/')[0]}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 md:gap-6">
      {relatedPosts.map((p) => (
        <PostCard post={p} />
      ))}
    </div>
  </section>
)}
