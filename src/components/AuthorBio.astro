---
import { AUTHOR_NAME, AUTHOR_EMAIL } from '../consts';
---

<div class="bg-soft/5 border border-soft/20 rounded-lg p-4 sm:p-6 md:p-8 mt-8 sm:mt-10 md:mt-12 mb-8 sm:mb-10 md:mb-12">
  <div class="flex gap-3 sm:gap-4 md:gap-6">
    <div class="flex-shrink-0">
      <div class="w-16 h-16 sm:w-18 sm:h-18 md:w-20 md:h-20 bg-accent rounded-full flex items-center justify-center text-2xl sm:text-2xl md:text-3xl font-display text-secondary">
        K
      </div>
    </div>
    <div class="flex-1">
      <h3 class="font-display text-xl font-bold text-primary mb-2">About {AUTHOR_NAME}</h3>
      <p class="text-primary/80 mb-4">
        Kseniia is a travel writer and digital nomad who spends her time exploring slower, lesser-known corners of the world.
        She writes practical guides for other travelers and nomads looking to live better, work remotely, and travel more intentionally.
      </p>
      <p class="text-sm text-primary/60">
        <a href={`mailto:${AUTHOR_EMAIL}`} class="text-accent hover:underline">
          Get in touch
        </a>
      </p>
    </div>
  </div>
</div>
