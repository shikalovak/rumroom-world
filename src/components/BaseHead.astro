---
import { SITE_TITLE, SITE_URL } from '../consts';
import type { Lang } from '../i18n/strings';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: URL | string;
  pubDate?: Date;
  author?: string;
  articleType?: string;
  robots?: string;
  lang?: Lang;
  altLangPath?: string;
}

const {
  title,
  description,
  image = `${SITE_URL}/og-image.png`,
  canonicalURL = new URL(Astro.url.pathname, SITE_URL),
  pubDate,
  author = 'Kseniia',
  articleType = 'article',
  robots,
  lang = 'en',
  altLangPath,
} = Astro.props;

// Compute hreflang alternates. Always emit self + the other lang if known.
const selfPath = Astro.url.pathname;
const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const alternates: Array<{ hreflang: string; href: string }> = [
  { hreflang: lang, href: `${SITE_URL}${selfPath}` },
];
if (altLangPath) {
  alternates.push({ hreflang: otherLang, href: `${SITE_URL}${altLangPath}` });
  // x-default → English version
  alternates.push({ hreflang: 'x-default', href: `${SITE_URL}${lang === 'en' ? selfPath : altLangPath}` });
}

const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';

const jsonLd = articleType === 'article' && pubDate ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: image,
  datePublished: pubDate.toISOString(),
  inLanguage: lang === 'ru' ? 'ru-RU' : 'en-US',
  author: {
    '@type': 'Person',
    name: author,
  },
} : undefined;
---

<!-- Meta tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- SEO Meta Tags -->
<title>{title} | {SITE_TITLE}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates -->
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}

<!-- Open Graph Tags -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={articleType === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- JSON-LD Schema -->
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
