---
import { AUTHOR_EMAIL, SITE_TITLE } from '../consts';
import { t, type Lang, homePath, aboutPath, pillarPath } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang);
---

<footer id="newsletter" class="bg-soft border-t border-primary/10 mt-8 sm:mt-12 md:mt-16 py-8 sm:py-10 md:py-14">
  <div class="container-main">
    <!-- Subscribe section -->
    <div class="max-w-2xl mx-auto text-center mb-8 sm:mb-10 md:mb-12">
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-4 tracking-tight">
        {s.footer_subscribe_heading}
      </h2>
      <p class="text-primary/70 mb-8">
        {s.footer_subscribe_blurb}
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
        <input
          type="email"
          placeholder={s.footer_email_placeholder}
          required
          class="flex-1 px-5 py-3 border border-primary/30 bg-secondary text-primary rounded-md focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
        />
        <input
          type="text"
          placeholder={s.footer_name_placeholder}
          class="flex-1 sm:max-w-[40%] px-5 py-3 border border-primary/30 bg-secondary text-primary rounded-md focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
        />
        <button type="submit" class="btn-secondary whitespace-nowrap">
          {s.footer_subscribe_button}
        </button>
      </form>
      <p class="text-xs text-primary/50 mt-4">
        {s.footer_privacy_disclaimer_lead} <a href={s.privacy_path} class="underline hover:text-accent">{s.footer_privacy_link_text}</a>.
      </p>
    </div>

    <!-- Bottom links row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8 pt-8 border-t border-primary/10">
      <div>
        <a href={homePath(lang)} class="inline-block">
          <img src="/logo.png" alt={SITE_TITLE} class="h-10 w-auto mb-3" />
        </a>
        <p class="text-sm text-primary/60">{s.footer_blurb}</p>
      </div>
      <div>
        <h3 class="font-bold text-sm uppercase tracking-wide text-primary mb-3">{s.footer_section_site}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={aboutPath(lang)} class="text-primary/70 hover:text-accent transition-colors">{s.footer_link_about}</a></li>
          <li><a href={pillarPath(lang, 'bali')} class="text-primary/70 hover:text-accent transition-colors">{s.footer_link_bali}</a></li>
          <li><a href={pillarPath(lang, 'france')} class="text-primary/70 hover:text-accent transition-colors">{s.footer_link_france}</a></li>
          <li><a href={s.privacy_path} class="text-primary/70 hover:text-accent transition-colors">{s.footer_link_privacy}</a></li>
          <li><a href={s.disclosure_path} class="text-primary/70 hover:text-accent transition-colors">{s.footer_link_disclosure}</a></li>
          <li>
            <a href={lang === 'ru' ? '/' : '/ru/'} class="text-primary/70 hover:text-accent transition-colors">
              {lang === 'ru' ? s.lang_switch_to_en : s.lang_switch_to_ru}
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-bold text-sm uppercase tracking-wide text-primary mb-3">{s.footer_section_contact}</h3>
        <p class="text-sm">
          <a href={`mailto:${AUTHOR_EMAIL}`} class="text-primary/70 hover:text-accent transition-colors">
            {AUTHOR_EMAIL}
          </a>
        </p>
      </div>
    </div>
    <div class="pt-8 mt-8 border-t border-primary/10 text-center text-xs text-primary/50">
      <p>{s.footer_copyright}</p>
    </div>
  </div>
</footer>
