---
import { SITE_TITLE } from '../consts';
import { t, type Lang, homePath, aboutPath, pillarPath } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang);
---

<header class="bg-secondary border-b border-primary/5">
  <div class="container-main py-4">
    <nav class="grid grid-cols-3 items-center gap-4">
      <!-- Left: nav links -->
      <ul class="flex gap-3 sm:gap-4 md:gap-6 items-center justify-self-start">
        <li>
          <a
            href={pillarPath(lang, 'bali')}
            class="font-body text-base font-semibold text-primary hover:text-accent transition-colors"
          >
            {s.nav_bali}
          </a>
        </li>
        <li class="hidden sm:block">
          <a
            href={aboutPath(lang)}
            class="font-body text-base font-semibold text-primary hover:text-accent transition-colors"
          >
            {s.nav_about}
          </a>
        </li>
      </ul>

      <!-- Center: logo -->
      <a href={homePath(lang)} class="block justify-self-center" aria-label={SITE_TITLE}>
        <img
          src="/logo.png"
          alt={SITE_TITLE}
          class="h-12 md:h-14 w-auto"
          width="250"
          height="80"
        />
      </a>

      <!-- Right: subscribe CTA -->
      <div class="justify-self-end">
        <a href="#newsletter" class="btn-primary text-sm">
          {s.nav_subscribe}
        </a>
      </div>
    </nav>
  </div>
</header>
