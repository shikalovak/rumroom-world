---
import BaseLayout from '../../layouts/BaseLayout.astro';

const unsplashAttribution = {
  id: 'photo-1544644181-1484b3fdfc62',
  photographer: 'Sebastian Pena Lambarri',
  profileUrl: 'https://unsplash.com/@sebaspenalambarri',
  photoUrl: 'https://images.unsplash.com/photo-1544644181-1484b3fdfc62?w=1200&h=600&fit=crop',
};

const affiliates = {
  airalo: 'https://airalo.tpm.li/4rMthhOs',
  wise: 'https://wise.com/invite/irhc/kseniias372',
  safetywing: 'https://safetywing.com/?referenceID=26521603&utm_source=26521603&utm_medium=Ambassador',
};
---

<BaseLayout
  title="Bali Starter Pack — Complete Travel Guide"
  description="Exclusive lead magnet for Rumroom World email subscribers. Everything you need: visas, where to stay, food, nightlife, safety, costs, and more."
  image={unsplashAttribution.photoUrl}
  robots="noindex, nofollow"
>
  <article class="min-h-screen bg-white">
    {/* Hero Section */}
    <div class="relative w-full overflow-hidden py-8 sm:py-12 md:py-16" style={`background-image: linear-gradient(rgba(30, 58, 138, 0.7), rgba(30, 58, 138, 0.7)), url('${unsplashAttribution.photoUrl}'); background-size: cover; background-position: center;`}>
      <div class="mx-auto max-w-3xl px-4 sm:px-6 md:px-8">
        <div class="text-center">
          <h1 class="text-3xl font-bold text-white sm:text-4xl md:text-5xl leading-tight mb-4">
            Bali Starter Pack
          </h1>
          <p class="text-base sm:text-lg text-blue-100 mb-2">
            Your complete travel guide — exclusive for email subscribers
          </p>
          <p class="text-sm sm:text-base text-blue-200">
            Visas, costs, where to stay, food, safety, nightlife, and everything else you need
          </p>
        </div>
      </div>
    </div>

    {/* Attribution */}
    <div class="bg-gray-50 border-t border-gray-200 py-3 px-4 sm:px-6 md:px-8 text-center">
      <p class="text-xs sm:text-sm text-gray-600">
        Hero photo by <a href={unsplashAttribution.profileUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline">{unsplashAttribution.photographer}</a> on Unsplash
      </p>
    </div>

    {/* Main Content */}
    <main class="mx-auto max-w-3xl px-4 sm:px-6 md:px-8 py-8 sm:py-12 md:py-16 space-y-16 sm:space-y-20">

      {/* Section 1: First-Timer Cheat Sheet */}
      <section>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">
          1. Bali First-Timer Cheat Sheet
        </h2>

        <div class="prose prose-sm sm:prose max-w-none space-y-6">
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed">
            Do's, don'ts, scams to watch, packing essentials, transport options, and survival Bahasa phrases.
          </p>

          <div class="bg-gray-50 rounded-lg p-4 sm:p-6">
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Key Do's & Don'ts</h3>
            <ul class="space-y-2 text-sm sm:text-base text-gray-700">
              <li><strong>✓ Do:</strong> Wear a sarong at temples. Respect Hindu customs.</li>
              <li><strong>✓ Do:</strong> Learn basic Bahasa phrases (see below).</li>
              <li><strong>✗ Don't:</strong> Point at people with one finger (rude).</li>
              <li><strong>✗ Don't:</strong> Touch someone's head (sacred).</li>
              <li><strong>✗ Don't:</strong> Eat/gesture with left hand (impolite).</li>
            </ul>
          </div>

          <div class="bg-yellow-50 border-l-4 border-yellow-300 p-4 sm:p-6">
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Common Scams to Watch</h3>
            <ul class="space-y-2 text-sm sm:text-base text-gray-700">
              <li><strong>Fake taxis:</strong> Always use blue Bird or Grab app.</li>
              <li><strong>Drink spiking:</strong> Don't leave drinks unattended at bars.</li>
              <li><strong>ATM skimming:</strong> Use ATMs inside banks or malls.</li>
              <li><strong>Overpriced tours:</strong> Book through reputable agencies or hotels.</li>
              <li><strong>Jewelry stores:</strong> Aggressive upsell at street-front jewelry stores in tourist zones — politely decline and walk away.</li>
            </ul>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm sm:text-base border-collapse">
              <thead>
                <tr class="bg-gray-200">
                  <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Item</th>
                  <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Why Essential</th>
                </tr>
              </thead>
              <tbody>
                <tr class="hover:bg-gray-50">
                  <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Sunscreen SPF 50+</strong></td>
                  <td class="border border-gray-300 px-3 sm:px-4 py-2">Equatorial sun = burn fast. Reapply every 2 hours.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Lightweight rain jacket</strong></td>
                  <td class="border border-gray-300 px-3 sm:px-4 py-2">Tropical showers come fast. Pack-able is key.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Quick-dry clothes</strong></td>
                  <td class="border border-gray-300 px-3 sm:px-4 py-2">Humidity = cotton stays wet. Nylon/polyester dries in 2–3 hours.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Insect repellent (DEET)</strong></td>
                  <td class="border border-gray-300 px-3 sm:px-4 py-2">Dengue + malaria in Bali. DEET 20%+ is standard.</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Antidiarrheal meds</strong></td>
                  <td class="border border-gray-300 px-3 sm:px-4 py-2">Imodium or generic. Food safety varies; better to have it.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div>
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Getting Around: Transport Options</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm sm:text-base border-collapse">
                <thead>
                  <tr class="bg-gray-200">
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Option</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Cost</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Best For</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Scooter rental</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">IDR 50–80k/day ($3–5)</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Independence, but risky. Helmet + insurance required.</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Grab (ride-share)</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">IDR 20–100k per ride</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Safe, app-based, best for night + wet weather.</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Private driver</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">IDR 600k–800k/day ($37–50)</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Groups, tours, all-day excursions.</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Walking</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Free</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Short trips within neighborhoods. Wear sunscreen.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Survival Bahasa (key phrases)</h3>
            <ul class="space-y-2 text-sm sm:text-base text-gray-700">
              <li><strong>"Berapa harganya?"</strong> = How much? (pronounced: buh-RAH-pah HAR-gah-nya)</li>
              <li><strong>"Terima kasih"</strong> = Thank you (pronounced: tuh-REE-mah KAH-sih)</li>
              <li><strong>"Permisi"</strong> = Excuse me (pronounced: per-MEE-see)</li>
              <li><strong>"Sudah"</strong> = Already / enough (to politely decline)</li>
              <li><strong>"Tidak, terima kasih"</strong> = No, thanks (pronounced: tee-AHK, tuh-REE-mah KAH-sih)</li>
              <li><strong>"Mana toilet?"</strong> = Where's the bathroom? (pronounced: MAH-nah TOE-lut)</li>
              <li><strong>"Saya vegetarian"</strong> = I'm vegetarian (pronounced: SAH-yah vuh-juh-TAH-ree-ahn)</li>
            </ul>
          </div>

          <div class="bg-red-50 border-l-4 border-red-300 p-4 sm:p-6">
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Emergency Contacts</h3>
            <ul class="space-y-2 text-sm sm:text-base text-gray-700">
              <li><strong>Police (Polda):</strong> 0361-222-802 or ask hotel staff</li>
              <li><strong>Ambulance:</strong> 118</li>
              <li><strong>Tourist Police:</strong> 0361-759-170 (English-speaking, Kuta area)</li>
              <li><strong>Your embassy:</strong> Look up your country's embassy at <a href="https://embassiesworldwide.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">embassiesworldwide.com</a> before you travel and save the number in your phone.</li>
            </ul>
          </div>
        </div>
      </section>

      {/* Section 2: Visa Decision Tree */}
      <section>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">
          2. Bali Visa Decision Tree
        </h2>

        <div class="prose prose-sm sm:prose max-w-none space-y-6">
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed">
            Flowchart by trip duration + activity → visa type + cost + DIY vs. agent breakdown.
          </p>

          <div class="bg-blue-50 rounded-lg p-4 sm:p-6 space-y-4">
            <div>
              <h3 class="font-bold text-gray-900 text-base sm:text-lg mb-2">Are you visiting for less than 30 days?</h3>
              <p class="text-sm sm:text-base text-gray-700">
                <strong>→ Yes (0–30 days):</strong> You likely qualify for Visa-Free (B211A). No visa needed. Immigration stamp on arrival = automatic 30-day permission.
              </p>
              <p class="text-sm sm:text-base text-gray-700 mt-2">
                <strong>→ No (30+ days):</strong> You need a visa. Continue below.
              </p>
            </div>

            <div class="border-t border-blue-200 pt-4">
              <h3 class="font-bold text-gray-900 text-base sm:text-lg mb-2">What's your main activity?</h3>
              <ul class="space-y-3 text-sm sm:text-base text-gray-700">
                <li><strong>Tourism only:</strong> Visa on Arrival (VOA) or E-Visa. Costs IDR 500k ($30). Single-entry, 30-day stay.</li>
                <li><strong>Remote work / digital nomad:</strong> B211A extension (30 days) + B211A + multiple re-entry. Or B211A Visa + STAYC (60–180 days). IDR 1–3M depending on route.</li>
                <li><strong>Teaching / employment:</strong> B211A Sponsored (requires employer + formal process). Takes 4–6 weeks. Costs IDR 2–4M.</li>
                <li><strong>Retirement / long-term stay (60+ days):</strong> B211A Visa (60 days, IDR 2M) extended to 180 days (STAYC). Requires proof of funds + sponsorship.</li>
              </ul>
            </div>
          </div>

          <div>
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">Visa Cost Summary (2026)</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm sm:text-base border-collapse">
                <thead>
                  <tr class="bg-gray-200">
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Visa Type</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Duration</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Cost (IDR)</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Cost (USD)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>Visa-Free (B211A)</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">30 days</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Free</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">Free</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>E-Visa / VOA</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">30 days (1 entry)</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">500k</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">$31</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>B211A Visa</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">60 days</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">1.5–2M</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">$94–125</td>
                  </tr>
                  <tr class="hover:bg-gray-50">
                    <td class="border border-gray-300 px-3 sm:px-4 py-2"><strong>STAYC (Extended)</strong></td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">180 days</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">3–4M</td>
                    <td class="border border-gray-300 px-3 sm:px-4 py-2">$188–250</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <h3 class="font-bold text-gray-900 mb-3 text-base sm:text-lg">DIY vs. Agent</h3>
            <p class="text-sm sm:text-base text-gray-700 mb-3">
              <strong>DIY:</strong> Apply online at imigrasi.go.id or in person at immigration office. Saves cost but time-intensive (long queues, paperwork).
            </p>
            <p class="text-sm sm:text-base text-gray-700 mb-3">
              <strong>Agent:</strong> Local visa agents (IDR 500k–1M extra) handle paperwork. Faster but costs more. Research trusted options on <a href="https://www.reddit.com/r/bali/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">r/bali</a> or <a href="https://www.reddit.com/r/Indonesia/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">r/Indonesia</a> for community recommendations.
            </p>
            <p class="text-sm sm:text-base text-gray-700">
              <strong>Recommendation:</strong> If 30 days: use Visa-Free. If 60+ days + working: use agent (saves hassle).
            </p>
          </div>
        </div>
      </section>

      {/* Section 3: Where to Stay */}
      <section>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">
          3. Where to Stay in Bali
        </h2>

        <div class="prose prose-sm sm:prose max-w-none space-y-6">
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed">
            5-question quiz → personalized area recommendation (Canggu / Ubud / Uluwatu / Seminyak / Sanur) + stay options.
          </p>

          <div class="bg-gray-50 rounded-lg p-4 sm:p-6">
            <h3 class="font-bold text-gray-900 mb-4 text-base sm:text-lg">Quick Self-Quiz (pick your vibe)</h3>
            <ol class="space-y-4 text-sm sm:text-base text-gray-700">
              <li><strong>1. Social scene?</strong> A) Party/nightlife, B) Yoga/wellness, C) Adventure/outdoors, D) Upscale/resort, E) Local/quiet</li>
              <li><strong>2. Budget?</strong> A) Backpacker ($20–40/night), B) Budget-mid ($50–100/night), C) Mid-range ($100–200/night), D) Upscale ($200+/night)</li>
              <li><strong>3. Activities?</strong> A) Beaches/surfing, B) Culture/temples, C) Hiking/nature, D) Dining/shopping, E) Mix</li>
              <li><strong>4. WiFi priority?</strong> A) Essential (work/nomad), B) Nice to have</li>
              <li><strong>5. Distance from airport?</strong> A) Close (20 min), B) Doesn't matter (I have time)</li>
            </ol>
          </div>

          <div className="space-y-4">
            <div class="border-l-4 border-blue-400 bg-blue-50 p-4 sm:p-6">
              <h3 class="font-bold text-gray-900 mb-2 text-base sm:text-lg">Canggu</h3>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Vibe:</strong> Young, party-focused, digital nomads, tourists, trendy cafés, beaches.</p>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Best for:</strong> Party animals, remote workers, surfers, meeting people.</p>
              <p class="text-sm sm:text-base text-gray-700"><strong>Stay:</strong> Browse curated picks in our <a href="/bali/where-to-stay/" class="text-blue-600 hover:underline font-medium">Bali: Where to Stay guide</a> or search <a href="https://www.booking.com/searchresults.html?ss=Canggu" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Booking.com for Canggu</a> to filter by price and rating.</p>
            </div>

            <div class="border-l-4 border-green-400 bg-green-50 p-4 sm:p-6">
              <h3 class="font-bold text-gray-900 mb-2 text-base sm:text-lg">Ubud</h3>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Vibe:</strong> Calm, cultural, rice terraces, yoga, vegan food, expats, quiet.</p>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Best for:</strong> Yoga people, writers, culture seekers, wellness travelers.</p>
              <p class="text-sm sm:text-base text-gray-700"><strong>Stay:</strong> Browse curated picks in our <a href="/bali/where-to-stay/" class="text-blue-600 hover:underline font-medium">Bali: Where to Stay guide</a> or search <a href="https://www.booking.com/searchresults.html?ss=Ubud" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Booking.com for Ubud</a> to filter by price and rating.</p>
            </div>

            <div class="border-l-4 border-purple-400 bg-purple-50 p-4 sm:p-6">
              <h3 class="font-bold text-gray-900 mb-2 text-base sm:text-lg">Uluwatu</h3>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Vibe:</strong> Clifftop, sunset obsession, adventure, smaller crowds, indie travelers.</p>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Best for:</strong> Photographers, couples, adventurous solos, sunset chasers.</p>
              <p class="text-sm sm:text-base text-gray-700"><strong>Stay:</strong> Browse curated picks in our <a href="/bali/where-to-stay/" class="text-blue-600 hover:underline font-medium">Bali: Where to Stay guide</a> or search <a href="https://www.booking.com/searchresults.html?ss=Uluwatu" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Booking.com for Uluwatu</a> to filter by price and rating.</p>
            </div>

            <div class="border-l-4 border-orange-400 bg-orange-50 p-4 sm:p-6">
              <h3 class="font-bold text-gray-900 mb-2 text-base sm:text-lg">Seminyak</h3>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Vibe:</strong> Upscale, beach clubs, fancy dining, resort scene, tourists.</p>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Best for:</strong> Luxury travelers, couples, resort visitors, foodies.</p>
              <p class="text-sm sm:text-base text-gray-700"><strong>Stay:</strong> Browse curated picks in our <a href="/bali/where-to-stay/" class="text-blue-600 hover:underline font-medium">Bali: Where to Stay guide</a> or search <a href="https://www.booking.com/searchresults.html?ss=Seminyak" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Booking.com for Seminyak</a> to filter by price and rating.</p>
            </div>

            <div class="border-l-4 border-teal-400 bg-teal-50 p-4 sm:p-6">
              <h3 class="font-bold text-gray-900 mb-2 text-base sm:text-lg">Sanur</h3>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Vibe:</strong> Local, fishing port, seafood, quiet, few tourists, laid-back.</p>
              <p class="text-sm sm:text-base text-gray-700 mb-2"><strong>Best for:</strong> Local experience, seafood lovers, budget travelers, peace.</p>
              <p class="text-sm sm:text-base text-gray-700"><strong>Stay:</strong> Browse curated picks in our <a href="/bali/where-to-stay/" class="text-blue-600 hover:underline font-medium">Bali: Where to Stay guide</a> or search <a href="https://www.booking.com/searchresults.html?ss=Sanur" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">Booking.com for Sanur</a> to filter by price and rating.</p>
            </div>
          </div>
        </div>
      </section>

      {/* Section 4: Cost of Living */}
      <section>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">
          4. Real Cost of Living in Bali
        </h2>

        <div class="prose prose-sm sm:prose max-w-none space-y-6">
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed">
            Plug in lifestyle → weekly + monthly cost projections for 2026 (backpacker / mid / nomad / luxury).
          </p>

          <div class="bg-gray-50 rounded-lg p-4 sm:p-6">
            <h3 class="font-bold text-gray-900 mb-4 text-base sm:text-lg">Daily Breakdown by Tier</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm sm:text-base border-collapse">
                <thead>
                  <tr class="bg-gray-200">
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Category</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Backpacker</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Mid-Range</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Nomad</th>
                    <th class="border border-gray-300 px-3 sm:px-4 py-2 text-left font-bold">Luxury</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="hover:bg-gray-50">
