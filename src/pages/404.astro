---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const popularPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist"
>
  <div class="container-main py-20">
    <div class="text-center mb-16">
      <h1 class="font-display text-6xl font-bold text-primary mb-4">404</h1>
      <p class="text-2xl text-primary/80 mb-8">
        Oops! The page you're looking for doesn't exist.
      </p>
      <a href="/" class="btn-primary">
        Back to Home
      </a>
    </div>

    <div class="max-w-4xl mx-auto">
      <h2 class="font-display text-2xl font-bold text-primary mb-8 text-center">Popular Articles</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
