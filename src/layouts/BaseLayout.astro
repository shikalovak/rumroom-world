---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import type { Lang } from '../i18n/strings';

interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  author?: string;
  robots?: string;
  lang?: Lang;
  // Path (no origin) of the equivalent page in the other language, e.g. "/ru/about/" or "/about/".
  // When supplied, BaseHead emits hreflang alternate links.
  altLangPath?: string;
}

const { title, description, image, pubDate, author, robots, lang = 'en', altLangPath } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      pubDate={pubDate}
      author={author}
      robots={robots}
      lang={lang}
      altLangPath={altLangPath}
    />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
