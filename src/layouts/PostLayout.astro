---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import EmailMagnet from '../components/EmailMagnet.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, heroImageCredit, author, readingTime, cluster } = post.data;
const { Content } = await post.render();

const country = cluster.split('/')[0];
const countryName = country.charAt(0).toUpperCase() + country.slice(1);

// Cluster → emoji + soft pastel mapping (Tilda-style)
const clusterStyles: Record<string, { emoji: string; bg: string }> = {
  bali: { emoji: '🌴', bg: 'bg-gradient-to-br from-teal-50 via-emerald-50 to-cyan-100' },
  spain: { emoji: '🇪🇸', bg: 'bg-gradient-to-br from-amber-50 via-orange-50 to-red-100' },
  france: { emoji: '🇫🇷', bg: 'bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-100' },
  portugal: { emoji: '🇵🇹', bg: 'bg-gradient-to-br from-rose-50 via-pink-50 to-fuchsia-100' },
  hungary: { emoji: '🇭🇺', bg: 'bg-gradient-to-br from-lime-50 via-green-50 to-emerald-100' },
};
const heroStyle = clusterStyles[country] || { emoji: '✈️', bg: 'bg-soft' };

const hasRealImage = heroImage && !heroImage.startsWith('/images/');
const ogImage = hasRealImage ? heroImage : '/og-image.png';

// Pretty date format
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} image={ogImage} pubDate={pubDate} author={author}>
  <article>
    <!-- Hero — wider container (768px) for visual impact, slightly shorter -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
      {hasRealImage ? (
        <img
          src={heroImage}
          alt={heroImageAlt || title}
          class="w-full h-64 sm:h-80 object-cover rounded-tilda"
        />
      ) : (
        <div
          class={`w-full h-64 sm:h-80 rounded-tilda ${heroStyle.bg} flex items-center justify-center`}
          role="img"
          aria-label={heroImageAlt || title}
        >
          <span class="text-7xl sm:text-8xl" aria-hidden="true">{heroStyle.emoji}</span>
        </div>
      )}
      {heroImageCredit && (
        <p class="text-xs opacity-60 mt-2">
          Photo by{' '}
          <a class="underline" href={heroImageCredit.profileUrl} target="_blank" rel="noopener noreferrer">
            {heroImageCredit.photographer}
          </a>
          {' '}on{' '}
          <a class="underline" href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
      )}
    </div>

    <!-- All article content — narrow container (672px) for optimal reading -->
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <!-- Title block -->
      <header class="pt-10 pb-8">
        <!-- Cluster tag -->
        <div class="text-xs uppercase tracking-widest text-accent font-bold mb-4">
          {countryName}
        </div>
        <h1 class="font-display text-3xl sm:text-4xl md:text-[2.5rem] font-bold text-primary leading-tight mb-5 tracking-tight">
          {title}
        </h1>
        <p class="text-lg text-primary/70 leading-relaxed mb-6">
          {description}
        </p>
        <!-- Author + meta line -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-primary/60 pt-4 border-t border-primary/10">
          <span class="font-semibold text-primary">By {author || 'Kseniia'}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          {readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingTime} min read</span>
            </>
          )}
          {updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
            <>
              <span aria-hidden="true">·</span>
              <span class="italic">Updated {fmtDate(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      <!-- Affiliate disclosure -->
      <AffiliateDisclosure />

      <!-- Article body -->
      <div class="prose-article">
        <Content />
      </div>

      <!-- Related posts (within reading column) -->
      <RelatedPosts post={post} />

      <!-- Email magnet at the END (per design rules — never mid-article) -->
      <EmailMagnet country={countryName} leadMagnetName={`${countryName} Travel Guide`} />

      <!-- Author bio -->
      <AuthorBio />
    </div>
  </article>
</BaseLayout>
