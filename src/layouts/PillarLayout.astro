---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

interface Props {
  pillar: CollectionEntry<'pillars'>;
}

const { pillar } = Astro.props;
const { title, description, emoji, heroImage, heroImageAlt, heroImageCredit } = pillar.data;

const allPosts = await getCollection('posts');
const pillarPosts = allPosts
  .filter((p) => p.data.cluster.startsWith(pillar.slug) && !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Group by sub-cluster
const grouped: { [key: string]: typeof allPosts } = {};
pillarPosts.forEach((post) => {
  const subCluster = post.data.cluster.split('/')[1] || 'general';
  if (!grouped[subCluster]) {
    grouped[subCluster] = [];
  }
  grouped[subCluster].push(post);
});

const { Content } = await pillar.render();
---

<BaseLayout title={title} description={description}>
  <div class="container-main py-12">
    {heroImage && (
      <div class="max-w-3xl mx-auto mb-10">
        <img
          src={heroImage}
          alt={heroImageAlt || title}
          class="w-full h-64 sm:h-80 md:h-96 object-cover rounded-tilda"
        />
        {heroImageCredit && (
          <p class="text-xs opacity-60 mt-2 text-center">
            Photo by{' '}
            <a class="underline" href={heroImageCredit.profileUrl} target="_blank" rel="noopener noreferrer">
              {heroImageCredit.photographer}
            </a>
            {' '}on{' '}
            <a class="underline" href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </p>
        )}
      </div>
    )}

    <!-- Hero -->
    <header class="mb-12 sm:mb-16 text-center px-4">
      <div class="text-5xl sm:text-6xl mb-4">{emoji}</div>
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-primary mb-4 leading-tight">{title}</h1>
      <p class="text-base sm:text-lg md:text-xl text-primary/80 max-w-2xl mx-auto leading-relaxed">{description}</p>
    </header>

    <!-- Pillar Content -->
    <div class="prose-article mb-16">
      <Content />
    </div>

    <!-- Articles by Sub-Cluster -->
    {Object.entries(grouped).map(([subCluster, posts]) => (
      <section class="mb-16">
        <h2 class="font-display text-3xl font-bold text-primary mb-8 capitalize">
          {subCluster === 'general' ? 'Articles' : subCluster.replace(/-/g, ' ')}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
